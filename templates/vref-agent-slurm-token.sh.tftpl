#!/bin/sh
# Managed by Terraform (module terraform-vantage-agents).
# Mint a Slurm token for ${identity} and replace the file vref-agent re-reads on
# every call. The file is replaced in one step, so the agent never sees a
# half-written token.
set -eu
umask 027
tmp=$(mktemp "${vref_dir}/.slurm.token.XXXXXX")
trap 'rm -f "$tmp"' EXIT
scontrol token username=${identity} lifespan=${lifespan} \
  | sed -n 's/^SLURM_JWT=//p' > "$tmp"
[ -s "$tmp" ] || { echo "scontrol returned no token" >&2; exit 1; }
chown root:vref-agent "$tmp"
chmod 0640 "$tmp"
mv "$tmp" "${token_file}"
trap - EXIT
